# CodeIgniter 4 Backend Ignores
backend/.env
backend/vendor/
backend/writable/*
!backend/writable/.gitkeep

# User Uploaded Files & Dynamic Media
backend/public/uploads/*
!backend/public/uploads/.gitkeep
backend/writable/uploads/*
!backend/writable/uploads/.gitkeep
public/uploads/*
!public/uploads/.gitkeep

